{
  "name": "poker-coach-ai-discord",
  "version": "1.0.0",
  "description": "Bot de Discord com IA (PokerCoach AI) para analise de maos de Texas Hold'em: GTO, Exploit e matematica aplicada.",
  "main": "dist/bot.js",
  "private": true,
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "dev": "ts-node --transpile-only src/bot.ts",
    "start": "ts-node src/bot.ts",
    "build": "tsc -p tsconfig.json",
    "start:prod": "node dist/bot.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "discord",
    "discord-bot",
    "poker",
    "gto",
    "anthropic",
    "claude",
    "typescript"
  ],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.0",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
