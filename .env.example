# ---------------------------------------------------------------------------
# Discord — https://discord.com/developers/applications
# ---------------------------------------------------------------------------
# Bot -> Token -> Reset Token
DISCORD_TOKEN=seu_token_do_bot_aqui

# General Information -> Application ID
DISCORD_CLIENT_ID=seu_application_id_aqui

# Opcional: registra o /poker apenas neste servidor (propagação instantânea,
# ideal para desenvolvimento). Vazio = registro global (leva até 1h).
# Já preenchido com o ID do seu servidor.
DISCORD_GUILD_ID=1545494366087413831

# ---------------------------------------------------------------------------
# Anthropic — https://console.anthropic.com/settings/keys
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# Ajustes do modelo (opcionais — os valores abaixo são os padrões)
# ---------------------------------------------------------------------------
# claude-sonnet-5   -> melhor custo/benefício (padrão)
# claude-opus-5     -> máxima capacidade de raciocínio
# claude-haiku-4-5  -> mais rápido e barato
ANTHROPIC_MODEL=claude-sonnet-5

# Teto de tokens da resposta (cobre raciocínio interno + texto visível).
ANTHROPIC_MAX_TOKENS=8000

# Profundidade de raciocínio: low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium

# ---------------------------------------------------------------------------
# Comportamento do bot (opcionais)
# ---------------------------------------------------------------------------
# Quantas mensagens do histórico de cada usuário manter em memória (0 desliga).
HISTORY_MAX_MESSAGES=8

# Minutos de inatividade até o histórico do usuário expirar.
HISTORY_TTL_MINUTES=30
